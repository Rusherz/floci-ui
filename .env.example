# Server-side proxy target
FLOCI_ORIGIN=http://localhost:4566

# Public client settings
NEXT_PUBLIC_FLOCI_SQS_ACCOUNT_ID=000000000000
NEXT_PUBLIC_FLOCI_SQS_POLL_MS=5000
# Comma-separated enabled services (or * for all)
# Allowed slugs: sqs,s3,sns,dynamodb,lambda,eventbridge,step-functions,ssm,secrets-manager,cloudwatch
NEXT_PUBLIC_FLOCI_ENABLED_SERVICES=*
