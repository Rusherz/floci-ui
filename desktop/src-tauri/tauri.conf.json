{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Floci Desktop",
  "version": "0.1.0",
  "identifier": "com.floci.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "node ./desktop/build-next-standalone.mjs",
    "frontendDist": "../noop"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": false,
    "windows": []
  }
}